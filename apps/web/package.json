    "@tanstack/react-query": "^5.90.2",
    "boring-avatars": "^2.0.4",
    "cors": "^2.8.5",
    "embla-carousel-class-names": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "express": "^5.1.0",
    "gsap": "^3.9.1",
    "isbot": "^5",
    "pinata": "^2.5.1",
